    "express": "^5.3.0",
    "tree-sitter-java": "^0.23.5",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
